{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Agentcoin Unified Registry (Stage 1)",
  "type": "object",
  "required": [
    "version",
    "updatedAt",
    "chain",
    "sources",
    "statusVocabulary",
    "components"
  ],
  "properties": {
    "version": {
      "type": "integer"
    },
    "updatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z$"
    },
    "chain": {
      "type": "object",
      "required": [
        "network",
        "genesis",
        "confirmDepth",
        "feeAtomic"
      ],
      "properties": {
        "network": {
          "type": "string",
          "minLength": 1
        },
        "genesis": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "confirmDepth": {
          "type": "integer"
        },
        "feeAtomic": {
          "type": "string",
          "pattern": "^[0-9]+$"
        }
      }
    },
    "sources": {
      "type": "object",
      "required": [
        "systemRegistry",
        "actionRegistry",
        "navTree",
        "auditDocs"
      ]
    },
    "statusVocabulary": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "componentId",
          "kind",
          "purpose",
          "env",
          "host",
          "process",
          "sources",
          "expectedVersion",
          "routes",
          "storage",
          "dependsOn",
          "network",
          "expected",
          "observed",
          "verification",
          "checkMethod",
          "proofSource"
        ],
        "properties": {
          "componentId": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{1,63}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "blockchain-node",
              "miner",
              "proxy",
              "static-site",
              "app",
              "gateway",
              "queue",
              "monitor",
              "env",
              "sdk",
              "cli",
              "mcp",
              "pilot"
            ]
          },
          "purpose": {
            "type": "string",
            "minLength": 1
          },
          "env": {
            "type": "string",
            "minLength": 1
          },
          "host": {
            "type": "string",
            "minLength": 1
          },
          "process": {
            "type": "string",
            "minLength": 1
          },
          "sources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "expectedVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "observedVersion": {
            "type": [
              "string",
              "null"
            ]
          },
          "routes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "host",
                "path",
                "owner",
                "note"
              ],
              "properties": {
                "host": {
                  "type": "string",
                  "minLength": 1
                },
                "path": {
                  "type": "string",
                  "pattern": "^/"
                },
                "owner": {
                  "type": "boolean"
                },
                "note": {
                  "type": "string",
                  "minLength": 1
                },
                "method": {
                  "type": "string"
                },
                "aliasOf": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "env": {
                  "type": "string"
                }
              }
            }
          },
          "storage": {
            "type": [
              "string",
              "null"
            ]
          },
          "dependsOn": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "network": {
            "type": [
              "string",
              "null"
            ]
          },
          "expected": {
            "type": "object"
          },
          "observed": {
            "type": "object"
          },
          "verification": {
            "type": "object",
            "required": [
              "status",
              "evidence",
              "unknowns",
              "checkedAt"
            ],
            "properties": {
              "status": {
                "type": "string",
                "enum": [
                  "confirmed",
                  "partial",
                  "unknown",
                  "contradiction"
                ]
              },
              "evidence": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "unknowns": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "checkedAt": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}(:[0-9]{2})?Z$"
              }
            }
          },
          "observe": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "ssh": {
                "type": "object",
                "required": [
                  "host"
                ],
                "properties": {
                  "host": {
                    "type": "string",
                    "minLength": 1
                  },
                  "user": {
                    "type": "string",
                    "minLength": 1
                  },
                  "port": {
                    "type": "integer"
                  }
                }
              },
              "localBase": {
                "type": "string",
                "minLength": 1
              },
              "localEndpoints": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "units": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "files": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "listenPorts": {
                "type": "array",
                "items": {
                  "type": "integer"
                }
              },
              "publicBase": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "checkMethod": {
            "type": "string",
            "minLength": 1
          },
          "proofSource": {
            "type": "string",
            "minLength": 1
          },
          "chain": {
            "type": "object",
            "required": [
              "chainId",
              "genesis"
            ],
            "properties": {
              "chainId": {
                "type": "string",
                "pattern": "^[A-Z][A-Z0-9_]*$"
              },
              "genesis": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "activationParams": {
                "type": "string"
              },
              "syncSource": {
                "type": "string"
              }
            }
          },
          "actionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "navIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "bridges": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "chainId",
                "genesis"
              ],
              "properties": {
                "chainId": {
                  "type": "string",
                  "pattern": "^[A-Z][A-Z0-9_]*$"
                },
                "genesis": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "role": {
                  "type": "string"
                },
                "via": {
                  "type": "string"
                }
              }
            }
          }
        }
      }
    }
  },
  "description": "Канон Stage 1. tools/registry-check.mjs обязан читать этот файл и валидировать реестр по нему. Расхождение схемы и валидатора запрещено."
}