{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "iteration",
    "baseCommit",
    "resultCommit",
    "changedFiles",
    "commandsRun",
    "tests",
    "knownLimitations",
    "status"
  ],
  "properties": {
    "taskId": { "type": "string", "minLength": 3, "maxLength": 64 },
    "iteration": { "type": "integer", "minimum": 1, "maximum": 10 },
    "baseCommit": { "type": "string", "pattern": "[a-f0-9]{40}" },
    "resultCommit": { "type": "string", "pattern": "[a-f0-9]{40}", "description": "HEAD of the implementer worktree after committing the change" },
    "changedFiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 500,
      "items": { "type": "string", "pattern": "[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*" }
    },
    "commandsRun": {
      "type": "array",
      "maxItems": 200,
      "items": { "type": "string", "minLength": 1, "maxLength": 300 }
    },
    "tests": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["command", "exitCode", "ok"],
        "properties": {
          "command": { "type": "string", "minLength": 1, "maxLength": 300 },
          "exitCode": { "type": "integer", "minimum": -1, "maximum": 255 },
          "ok": { "type": "boolean" }
        }
      }
    },
    "knownLimitations": {
      "type": "array",
      "maxItems": 50,
      "items": { "type": "string", "minLength": 1, "maxLength": 500 }
    },
    "status": { "type": "string", "const": "submitted" }
  }
}
