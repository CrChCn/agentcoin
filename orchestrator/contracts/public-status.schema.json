{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentcoin/orchestrator/contracts/public-status.schema.json",
  "title": "Public Ops status (read-only, allowlisted)",
  "description": "Единственная форма, которую Ops API отдаёт наружу. Собрана из allowlist, а не вырезанием полей из внутреннего объекта: абсолютных путей, usernames, PID, внутренних адресов, промптов, stderr, credentials, operational memory и имён секретов здесь нет по построению.",
  "type": "object",
  "additionalProperties": false,
  "required": ["service", "generatedAt", "orchestrator", "queue", "tasks", "mission", "deployment"],
  "properties": {
    "service": { "type": "string", "const": "agentcoin-ops" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "orchestrator": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "stale", "heartbeatAgeSec", "continuous"],
      "properties": {
        "state": {
          "type": "string",
          "enum": ["never-started", "starting", "idle", "working", "partial", "recovering", "waiting", "stopped", "stopping", "stopped-by-signal", "breaker", "unknown"]
        },
        "stale": { "type": "boolean" },
        "heartbeatAgeSec": { "type": ["integer", "null"] },
        "continuous": { "type": "boolean" }
      }
    },
    "queue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pending", "leased", "done", "failed", "blocked", "total"],
      "properties": {
        "pending": { "type": "integer", "minimum": 0 },
        "leased": { "type": "integer", "minimum": 0 },
        "done": { "type": "integer", "minimum": 0 },
        "failed": { "type": "integer", "minimum": 0 },
        "blocked": { "type": "integer", "minimum": 0 },
        "total": { "type": "integer", "minimum": 0 }
      }
    },
    "tasks": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["taskId", "status", "attempts", "commit", "artifactSha", "triggerType"],
        "properties": {
          "taskId": { "type": "string", "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{2,63}" },
          "status": { "type": "string", "enum": ["pending", "leased", "done", "failed", "blocked"] },
          "attempts": { "type": "integer", "minimum": 0, "maximum": 100 },
          "commit": { "type": ["string", "null"], "pattern": "[0-9a-f]{7,40}" },
          "artifactSha": { "type": ["string", "null"], "pattern": "[a-f0-9]{64}" },
          "triggerType": { "type": ["string", "null"], "enum": ["registry_gap", "health_failure", "roadmap_item", "owner_goal", null] }
        }
      }
    },
    "mission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "priorities"],
      "properties": {
        "title": { "type": "string", "minLength": 3, "maxLength": 300 },
        "priorities": { "type": "array", "maxItems": 12, "items": { "type": "string", "minLength": 2, "maxLength": 80 } }
      }
    },
    "deployment": { "type": "string", "const": "not-enabled" }
  }
}
