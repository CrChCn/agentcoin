{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "verdict",
    "artifactSha256",
    "baseCommit",
    "resultCommit",
    "checks",
    "findings",
    "reviewer",
    "simulated",
    "reviewedAt",
    "notes"
  ],
  "properties": {
    "verdict": { "type": "string", "enum": ["ACCEPTED", "CHANGES_REQUESTED", "BLOCKED"] },
    "artifactSha256": { "type": "string", "pattern": "[a-f0-9]{64}" },
    "baseCommit": { "type": "string", "pattern": "[a-f0-9]{40}" },
    "resultCommit": { "type": "string", "pattern": "[a-f0-9]{40}" },
    "checks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 300,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "command", "exitCode", "ok", "detail"],
        "properties": {
          "name": { "type": "string", "minLength": 1, "maxLength": 200 },
          "command": { "type": "string", "maxLength": 300 },
          "exitCode": { "type": "integer", "minimum": -1, "maximum": 255 },
          "ok": { "type": "boolean" },
          "detail": { "type": "string", "maxLength": 2000 }
        }
      }
    },
    "findings": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["code", "severity", "detail", "file", "evidence"],
        "properties": {
          "code": { "type": "string", "pattern": "[A-Z][A-Z0-9_]{2,63}" },
          "severity": { "type": "string", "enum": ["blocker", "major", "minor"] },
          "detail": { "type": "string", "minLength": 3, "maxLength": 2000 },
          "file": { "type": "string", "maxLength": 300 },
          "evidence": { "type": "string", "maxLength": 4000 }
        }
      }
    },
    "reviewer": { "type": "string", "minLength": 3, "maxLength": 64 },
    "simulated": { "type": "boolean" },
    "reviewedAt": { "type": "string", "minLength": 20, "maxLength": 40 },
    "notes": { "type": "string", "maxLength": 4000 }
  }
}
