{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agentcoin/orchestrator/contracts/task.schema.json",
  "title": "Orchestrator task contract",
  "description": "Строгий контракт задания. Поля productionWrites/moneyOperations/consensusChanges зафиксированы const=false: агент не может включить их, не пройдя валидацию контракта.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "taskId",
    "title",
    "objective",
    "scope",
    "acceptance",
    "commandsAllowed",
    "networkPolicy",
    "productionWrites",
    "moneyOperations",
    "consensusChanges",
    "maxIterations",
    "maxRuntimePerAgentMinutes",
    "maxTotalRuntimeMinutes",
    "maxTotalTokens",
    "deadline"
  ],
  "properties": {
    "taskId": {
      "type": "string",
      "pattern": "[A-Za-z0-9][A-Za-z0-9._-]{2,63}",
      "description": "Неизменяемый идентификатор. Повторное использование с другим содержимым запрещено."
    },
    "title": { "type": "string", "minLength": 3, "maxLength": 200 },
    "objective": { "type": "string", "minLength": 10, "maxLength": 4000 },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowedPaths", "forbiddenPaths", "environment"],
      "properties": {
        "allowedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*/?" }
        },
        "forbiddenPaths": {
          "type": "array",
          "maxItems": 50,
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "[A-Za-z0-9._-]+(/[A-Za-z0-9._-]+)*/?" }
        },
        "environment": { "type": "string", "const": "isolated" }
      }
    },
    "acceptance": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": { "type": "string", "minLength": 3, "maxLength": 500 }
    },
    "commandsAllowed": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "node --test [A-Za-z0-9._/-]+" }
    },
    "networkPolicy": { "type": "string", "enum": ["none", "read-only", "approved"] },
    "productionWrites": { "type": "boolean", "const": false },
    "moneyOperations": { "type": "boolean", "const": false },
    "consensusChanges": { "type": "boolean", "const": false },
    "maxIterations": { "type": "integer", "minimum": 1, "maximum": 10 },
    "maxRuntimePerAgentMinutes": { "type": "integer", "minimum": 1, "maximum": 120 },
    "maxTotalRuntimeMinutes": { "type": "integer", "minimum": 1, "maximum": 480 },
    "maxTotalTokens": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 500000000,
      "description": "Жёсткий лимит учтённых токенов. При его превышении задание не может быть ACCEPTED."
    },
    "softTotalTokens": {
      "type": "integer",
      "minimum": 1000,
      "maximum": 500000000,
      "description": "Мягкий порог токенов: превышение пишется в журнал событием budget.soft_exceeded, но не блокирует задание."
    },
    "softRuntimePerAgentMinutes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120,
      "description": "Мягкий порог времени роли: превышение фиксируется, но не заменяет жёсткий maxRuntimePerAgentMinutes."
    },
    "trigger": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "evidence", "observedAt", "deduplicationKey"],
      "description": "Доказанное основание автоматической задачи. Без evidence планировщик задачу не ставит.",
      "properties": {
        "type": { "type": "string", "enum": ["registry_gap", "health_failure", "roadmap_item", "owner_goal"] },
        "evidence": { "type": "array", "minItems": 1, "maxItems": 8, "items": { "type": "string", "minLength": 3, "maxLength": 300 } },
        "observedAt": { "type": "string", "format": "date-time" },
        "deduplicationKey": { "type": "string", "pattern": "[a-f0-9]{64}" },
        "registryId": { "type": "string", "minLength": 1, "maxLength": 120 },
        "incident": {
          "type": "object",
          "additionalProperties": false,
          "description": "Поколение повторяющегося дефекта: RESOLVED → REOCCURRED увеличивает generation, поэтому старый ключ дедупликации не блокирует задачу навсегда.",
          "required": ["id", "generation"],
          "properties": {
            "id": { "type": "string", "minLength": 1, "maxLength": 120 },
            "generation": { "type": "integer", "minimum": 1, "maximum": 1000 },
            "state": { "type": "string", "enum": ["OPEN", "TASK_CREATED", "RESOLVED", "REOCCURRED"] }
          }
        }
      }
    },
    "deadline": { "type": "string", "format": "date-time" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "ref"],
      "description": "Локальный git-репозиторий, от которого берётся base задания. Без поля используется fixtures/task-src.",
      "properties": {
        "repo": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500,
          "description": "Каталог с .git: абсолютный путь или путь относительно каталога оркестратора. URL и сеть запрещены."
        },
        "ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._/-]*$",
          "description": "Ветка, тег или коммит, который становится baseCommit."
        }
      }
    }
  }
}
