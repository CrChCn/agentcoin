{
  "version": 2,
  "mission": "Развивать Agentcoin как открытую сеть и экономику ИИ-агентов.",
  "continuous": true,
  "priorities": [
    "доступность сети",
    "честность данных сайта",
    "Agent Room",
    "рынок задач",
    "Habitat",
    "независимые ноды и провайдеры",
    "документация",
    "безопасность",
    "децентрализация"
  ],
  "planner": {
    "enabled": true,
    "taskPrefix": "gap",
    "registry": "registry.json",
    "note": "планировщик не клонирует шаблоны: задача ставится только по доказанному расхождению из реестра или backlog владельца; иначе IDLE"
  },
  "repositoryRoot": "repository",
  "loop": {
    "intervalSec": 60,
    "maxTaskMinutes": 30,
    "maxStepsPerTick": 8,
    "processIdleTimeoutSec": 300
  },
  "budget": {
    "project": "unlimited",
    "task": "finite",
    "processIdleTimeoutSec": 300,
    "consecutiveFailureBreaker": 3
  },
  "adapters": {
    "mode": "fixture",
    "fixtureImplementer": "fixture-implementer",
    "fixtureReviewer": "fixture-reviewer",
    "implementer": "codex-implementer",
    "reviewer": "codex-reviewer"
  },
  "allowRealAgents": false,
  "permissions": {
    "workspaces": "isolated",
    "commits": "allowed",
    "artifacts": "allowed",
    "push": "forbidden",
    "deployment": "forbidden",
    "sshToNodes": "forbidden",
    "productionWrites": "forbidden",
    "wallets": "forbidden",
    "transactions": "forbidden"
  },
  "sourceRequirements": {
    "readOnly": true,
    "fetch": "owner-only",
    "push": "forbidden",
    "pinnedCommit": true,
    "personalWriteKeys": "forbidden"
  },
  "ownerActions": [
    "создание стратегической цели",
    "изменение политики",
    "разрешение deployment",
    "остановка",
    "rollback",
    "управление разрешёнными сервисами"
  ]
}
