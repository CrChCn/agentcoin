# /etc/agentcoin/ops.env — переменные окружения сервиса.
# Ставится install.sh только если файла ещё нет; права 0640 root:agt-orchestrator.

OPS_ROOT=/srv/agentcoin-ops
OPS_API_HOST=127.0.0.1
OPS_API_PORT=8799
OPS_STALE_AFTER_SEC=900
OPS_PUBLIC_ORIGIN=https://agentcoin.work

# Настоящие агенты включаются не здесь, а полем allowRealAgents/adapters.mode
# в queue/mission.json — и только после доказанной изоляции (adapterEndToEnd).
# Секреты в этот файл не пишутся: Codex авторизуется своей сессией.
