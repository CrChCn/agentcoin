{
  "version": 2,
  "note": "Реестр доказанных инвариантов. Задача ставится только если проверка ПАДАЕТ и такого задания ещё не было (deduplicationKey по поколению инцидента). Все записи ниже проверяются исполнением против repositoryRoot, а не чтением прозы: пустой реестр означал IDLE, а реестр без падающих проверок означает «расхождений не доказано». Форма новой записи — в _example.",
  "entries": [
    {
      "id": "ops-page-published",
      "enabled": true,
      "priority": 10,
      "type": "registry_gap",
      "check": { "kind": "file_exists", "path": "site/ops.html" },
      "task": {
        "taskId": "set-by-planner",
        "title": "Вернуть публичную страницу статуса оркестратора",
        "objective": "site/ops.html объявлен в site/tree.json как /ops и обязан существовать: без него публичный статус петли исчезает с сайта, а посетитель видит 404. Проверка реестра доказывает отсутствие файла.",
        "scope": { "allowedPaths": ["site"], "forbiddenPaths": ["config", "data", "node.mjs"], "environment": "isolated" },
        "acceptance": ["AC-1: node --test test/ops-page.mjs зелёный", "AC-2: страница не содержит методов записи в API"],
        "commandsAllowed": ["node --test test/ops-page.mjs"],
        "networkPolicy": "none",
        "productionWrites": false,
        "moneyOperations": false,
        "consensusChanges": false,
        "maxIterations": 3,
        "maxRuntimePerAgentMinutes": 20,
        "maxTotalRuntimeMinutes": 60,
