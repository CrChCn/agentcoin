[Unit]
Description=Agentcoin Ops deployer (disabled in C1/C2: no publication until staging exists)
Documentation=file:/opt/agentcoin-orchestrator/current/orchestrator/service/README.md
# Включается только владельцем: presence-файл и отдельный этап deployer.
ConditionPathExists=/etc/agentcoin/deploy-enabled

[Service]
Type=oneshot
User=agt-deployer
Group=agt-deployer
WorkingDirectory=/opt/agentcoin-orchestrator/current/orchestrator
EnvironmentFile=-/etc/agentcoin/ops.env
Environment=OPS_ROOT=/var/lib/agentcoin-orchestrator
Environment=OPS_LOG_DIR=/var/log/agentcoin-orchestrator
Environment=OPS_CONTROL_DIR=/var/lib/agentcoin-orchestrator/control
# Сейчас команда штатно завершается кодом 3 и записывает отказ в журнал.
ExecStart=/usr/bin/env node /opt/agentcoin-orchestrator/current/orchestrator/service/deployer.mjs
TimeoutStartSec=600

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
ReadWritePaths=/var/log/agentcoin-orchestrator
ReadOnlyPaths=/opt/agentcoin-orchestrator /var/lib/agentcoin-orchestrator
# Только UNIX-сокеты: у деплойера нет причин открывать сеть.
RestrictAddressFamilies=AF_UNIX
