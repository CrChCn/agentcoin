[Unit]
Description=Agentcoin Ops read-only API (loopback only)
Documentation=file:/srv/agentcoin-ops/orchestrator/service/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=agt-orchestrator
Group=agt-orchestrator
WorkingDirectory=/srv/agentcoin-ops/orchestrator
EnvironmentFile=-/etc/agentcoin/ops.env
Environment=OPS_ROOT=/srv/agentcoin-ops
Environment=OPS_API_HOST=127.0.0.1
Environment=OPS_API_PORT=8799
ExecStart=/usr/bin/env node service/opsd.mjs api
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# API ничего не пишет: доступен только на чтение файлов OPS_ROOT.
ReadOnlyPaths=/srv/agentcoin-ops
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Наружу не слушает: только loopback, публикует Caddy.
IPAddressAllow=localhost
IPAddressDeny=any

[Install]
WantedBy=multi-user.target
