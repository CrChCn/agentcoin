[Unit]
Description=Agentcoin Ops orchestrator (autonomous engineering loop, no production access)
Documentation=file:/opt/agentcoin-orchestrator/current/orchestrator/service/README.md
After=network-online.target
Wants=network-online.target
# Второй экземпляр запрещён: он получил бы тот же OPS_ROOT и тот же журнал.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=agt-orchestrator
Group=agt-orchestrator
# Код неизменяем и принадлежит root; рабочий каталог — только для чтения.
WorkingDirectory=/opt/agentcoin-orchestrator/current/orchestrator
EnvironmentFile=-/etc/agentcoin/ops.env
Environment=OPS_ROOT=/var/lib/agentcoin-orchestrator
Environment=OPS_LOG_DIR=/var/log/agentcoin-orchestrator
Environment=OPS_CONTROL_DIR=/var/lib/agentcoin-orchestrator/control
Environment=NODE_ENV=production
ExecStart=/usr/bin/env node /opt/agentcoin-orchestrator/current/orchestrator/service/opsd.mjs loop
Restart=always
RestartSec=10
KillSignal=SIGTERM
# Сервис доигрывает текущий шаг движка, поэтому остановка не мгновенная.
TimeoutStopSec=180

NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
CapabilityBoundingSet=
AmbientCapabilities=
UMask=0077
# Запись только в данные и журналы. Код и управляющий каталог STOP — read-only.
ReadWritePaths=/var/lib/agentcoin-orchestrator /var/log/agentcoin-orchestrator
ReadOnlyPaths=/opt/agentcoin-orchestrator
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
# Node нуждается в JIT: MemoryDenyWriteExecute здесь намеренно не включён.
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
