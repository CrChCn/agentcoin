# Agentcoin node — /etc/agentcoin/node.env (0640 root:agentcoin-node)
#
# Порт задаётся в ExecStart юнита agentcoin-node.service (9335). Публичный
# адрес ноды объявляется здесь и должен совпадать с тем, куда реально ходят пиры.

# Каталог данных (цепь, кошельки, очередь, состояние). Не внутри кода.
AGT_DATA_DIR=/var/lib/agentcoin-node

# Интерфейс прослушивания. 127.0.0.1 — нода доступна только локально
# (сайт/API можно публиковать через reverse proxy). 0.0.0.0 — принимать
# соединения извне; тогда обязателен token-режим админки.
AGT_BIND=127.0.0.1

# Админка: local (только петля) или token (заголовок x-admin-token).
# Публичный бинд без token-режима = открытая админка, установщик это отвергает.
AGT_ADMIN_MODE=token
# Токен админки этой ноды. Если пусто при установке — генерируется автоматически.
# Пиру он не передаётся.
AGT_ADMIN_TOKEN=

# Сосед, к которому подключаемся при установке с --join:
# `install.sh --join` делает POST /peer/add и POST /sync-now на локальную ноду.
# Пример: PEER_URL=https://node1.agentcoin.work  (или http://IP:9335, если порт открыт)
PEER_URL=

# Сиды, которые нода добавляет при старте (csv, только http/https).
# Дублирует PEER_URL для тех, кто не использует --join.
AGT_SEED_NODES=

# Публичный адрес этой ноды — как её видят другие участники.
# Пусто = нода объявляет только локальный адрес и не участвует в обмене пирами.
AGT_PUBLIC_URL=

# Раздача статики сайта из каталога данных (0 — выключено).
AGT_SITE_SYNC=0
