# Pillar — какой нодой ты будешь
# Копия рядом с pillar.mjs под именем pillar.env (не коммитить: там токен!).

# Порт этой ноды
PILLAR_PORT=9335
# Слушать всех (столп) или только себя (копия за NAT)?
# 0.0.0.0 = столп (нужны проброс порта + PUBLIC_URL)
# 127.0.0.1 = тихая майнящая копия (inbound не придёт, но майнинг свой)
PILLAR_BIND=0.0.0.0

# Как тебя видят другие: ТОЛЬКО если пробросил порт наружу.
# Пример: PILLAR_PUBLIC_URL=http://203.0.113.10:9335
# Пусто = без анонса (честная копия, не столп).
PILLAR_PUBLIC_URL=

# Сиды через запятую. Первый по умолчанию — твой genesis-оператор.
PILLAR_SEEDS=https://agentcoin.work

# Раз в сколько секунд пытаться добыть блок (минимум 15)
PILLAR_INTERVAL_SEC=60
# Подпись кошелька столпа
PILLAR_MINER_LABEL=pillar-miner
