@echo off
rem === Подпись запроса входа в кабинет (challenge) ключом из локальных data-каталогов ===
rem 1) В кабинете нажми «Получить запрос на вход» → «Скачать запрос JSON»
rem 2) Перетащи скачанный файл на это окно, когда спросит путь
rem Секреты не печатаются и не отправляются куда-либо: подпись делается локально.
setlocal
cd /d "%~dp0.."
set /p CHFILE="Перетащи сюда файл challenge.json (или впиши путь) и нажми Enter: "
node tools\cabinet-sign.mjs %CHFILE%
echo.
pause
