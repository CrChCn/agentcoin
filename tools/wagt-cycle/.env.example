# Пример окружения для сценария Sepolia. Только тестовые средства.
# Скопируй в .env (он в .gitignore) и подставь свои значения.
# НИКОГДА не коммить заполненный .env.

# RPC Sepolia (default уже встроен в hardhat.config.cjs)
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Приватный ключ ТЕСТОВОГО кошелька Sepolia (0x...). Без него скрипт
# выполняет только проверки фазы A (chainId, код Factory/Router02, газ).
SEPOLIA_PRIVATE_KEY=

# Порог подтверждений lock-транзакции AGT перед выпуском wAGT
WAGT_LOCK_CONFIRMATIONS=2
