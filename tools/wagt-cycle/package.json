{
  "name": "wagt-cycle",
  "version": "1.0.0",
  "private": true,
  "description": "Test AGT <-> wAGT cycle: isolated Agentcoin node + local EVM pool (Hardhat). Test funds only.",
  "type": "module",
  "scripts": {
    "cycle": "hardhat run scripts/cycle.mjs",
    "cycle:v2": "hardhat run scripts/cycle-v2.mjs",
    "cycle:sepolia": "hardhat run --network sepolia scripts/cycle-sepolia.mjs",
    "cycle:sepolia-fork": "hardhat run --config hardhat.fork.cjs scripts/cycle-sepolia.mjs",
    "accept:v2": "hardhat run scripts/accept-v2-mainnet.mjs"
  },
  "devDependencies": {
    "hardhat": "^2.22.0",
    "@nomicfoundation/hardhat-ethers": "^3.0.0",
    "ethers": "^6.13.0",
    "@openzeppelin/contracts": "^5.0.0"
  }
}